<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Tarifas de referencia precargadas (USD / M tokens).
         El cron diario actualiza todos los registros con auto_update=True
         usando la tabla interna `_DEFAULT_GEMINI_USD_PER_MILLION`.
         Los importes aquí son solo un punto de partida para instalaciones
         nuevas; en ejecución los mantendrá sincronizados el cron. -->

    <!-- ===== Claude Opus (familia 4.5+ a 5$/25$) ===== -->
    <record id="pricing_rate_claude_opus_4_new" model="llm.gemini.pricing.rate">
        <field name="name">Anthropic Claude Opus 4.5+</field>
        <field name="model_name_pattern">claude-opus-4-5</field>
        <field name="input_usd_per_million">5.00</field>
        <field name="output_usd_per_million">25.00</field>
        <field name="cached_input_usd_per_million">0.50</field>
        <field name="sequence">90</field>
        <field name="auto_update" eval="True" />
        <field name="notes">Opus 4.5, 4.6, 4.7, 4.8… (tarifa actualizada abril 2026).</field>
    </record>

    <!-- ===== Claude Opus 4.1 (tier caro legacy) ===== -->
