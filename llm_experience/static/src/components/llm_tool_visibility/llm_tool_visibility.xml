<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!--
        Pasos de herramienta: todos los usuarios ven la línea del paso
        (qué hizo, estado y duración). El detalle técnico (argumentos y JSON
        de resultado) sólo se despliega con el grupo de depuración.
    -->
    <t
    t-inherit="llm_thread.Message.ToolResultContent"
    t-inherit-mode="extension"
    owl="1"
  >
        <xpath expr="//div[hasclass('o_llm_step_body')]" position="attributes">
            <attribute name="t-if">llmToolDebugEnabled or step.error</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_llm_step_body')]//div[hasclass('o_llm_step_section')]" position="attributes">
            <attribute name="t-if">llmToolDebugEnabled</attribute>
        </xpath>
        <xpath expr="//i[hasclass('o_llm_step_chevron')]" position="attributes">
            <attribute name="t-if">llmToolDebugEnabled or step.error</attribute>
        </xpath>
    </t>

</templates>
