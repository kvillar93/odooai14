<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="llm_thread.Message.Thinking" owl="1">
        <details
            t-if="message.llmThinking"
            class="o_llm_thinking"
            t-att-class="{'o_llm_thinking--active': message.llmThinkingActive}"
            t-att-open="message.llmThinkingActive"
        >
            <summary class="o_llm_thinking_summary">
                <i t-if="message.llmThinkingActive" class="fa fa-circle-o-notch fa-spin o_llm_thinking_icon" aria-hidden="true"/>
                <i t-else="" class="fa fa-lightbulb-o o_llm_thinking_icon" aria-hidden="true"/>
                <span class="o_llm_thinking_label" t-esc="message.llmThinkingLabel"/>
                <i class="fa fa-angle-down o_llm_thinking_chevron" aria-hidden="true"/>
            </summary>
            <div class="o_llm_thinking_body" t-raw="message.llmThinkingHtml"/>
        </details>
    </t>

    <t t-name="llm_thread.Message.AssistantContent" owl="1">
        <t t-call="llm_thread.Message.Thinking"/>
        <div class="o_Message_prettyBody" t-ref="prettyBody" t-raw="message.prettyBody or message.body or ''" />
        <div t-if="message.llmMetaLine" class="o_llm_meta">
            <span t-esc="message.llmMetaLine"/>
        </div>
        <t t-if="!message.llmIsToolCallOnly">
        <div class="o_llm_message_vote mt-2 border-top pt-2" t-on-click.stop="">
            <span
                class="o_Message_command fa fa-lg mr-2"
                role="button"
                tabindex="0"
                title="Voto positivo"
                t-att-class="{'fa-thumbs-up text-primary': message.user_vote === 1, 'fa-thumbs-o-up': message.user_vote !== 1}"
                t-on-click="_onClickLlmThumbUp"
            />
            <span
                class="o_Message_command fa fa-lg"
                role="button"
                tabindex="0"
                title="Voto negativo"
                t-att-class="{'fa-thumbs-down text-primary': message.user_vote === -1, 'fa-thumbs-o-down': message.user_vote !== -1}"
                t-on-click="_onClickLlmThumbDown"
            />
        </div>
        </t>
    </t>

    <t t-name="llm_thread.Message.ToolResultContent" owl="1">
        <t t-set="step" t-value="message.llmToolStep or {}"/>
        <div class="o_Message_prettyBody o_llm_tool_result">
            <p class="d-none mb-0" t-ref="prettyBody" />
            <details
                class="o_llm_step"
                t-att-class="{'o_llm_step--running': step.running, 'o_llm_step--error': step.error}"
            >
                <summary class="o_llm_step_summary">
                    <span class="o_llm_step_status" aria-hidden="true">
                        <i t-if="step.running" class="fa fa-circle-o-notch fa-spin"/>
                        <i t-elif="step.error" class="fa fa-exclamation-circle"/>
                        <i t-else="" t-attf-class="fa {{ step.icon }}"/>
                    </span>
                    <span class="o_llm_step_label" t-esc="step.label"/>
                    <code t-if="step.target" class="o_llm_step_target" t-esc="step.target"/>
                    <span t-if="step.summary" class="o_llm_step_summaryText" t-esc="step.summary"/>
                    <span t-if="step.duration" class="o_llm_step_duration" t-esc="step.duration"/>
                    <i class="fa fa-angle-down o_llm_step_chevron" aria-hidden="true"/>
                </summary>
                <div class="o_llm_step_body">
                    <div t-if="step.error" class="o_llm_step_error" t-esc="step.error"/>
                    <div class="o_llm_step_section">
                        <div class="o_llm_step_sectionTitle">Argumentos</div>
                        <pre class="o_llm_step_pre"><code t-esc="message.llmToolArgsFormatted"/></pre>
                    </div>
                    <div t-if="!step.error and message.toolCallResultFormatted" class="o_llm_step_section">
                        <div class="o_llm_step_sectionTitle">Resultado</div>
                        <pre class="o_llm_step_pre o_llm_tool_result_pre"><code t-esc="message.toolCallResultFormatted"/></pre>
                    </div>
                </div>
            </details>
        </div>
    </t>

    <t t-name="llm_thread.Message.DefaultContent" owl="1">
        <div class="o_Message_prettyBody" t-ref="prettyBody" t-raw="message.prettyBody or message.body or ''" />
        <t t-if="message.subtype_description and !message.isBodyEqualSubtypeDescription">
            <p t-esc="message.subtype_description" class="mb-0" />
        </t>
        <t t-if="trackingValues.length > 0">
            <ul class="o_Message_trackingValues mb-0 pl-4">
                <t t-foreach="trackingValues" t-as="value" t-key="value.id">
                    <li>
                        <div class="o_Message_trackingValue" role="group">
                            <div class="o_Message_trackingValueFieldName o_Message_trackingValueItem" t-esc="value.changed_field"/>
                            <t t-if="value.old_value">
                                <div class="o_Message_trackingValueOldValue o_Message_trackingValueItem" t-esc="value.old_value"/>
                            </t>
                            <div class="o_Message_trackingValueSeparator o_Message_trackingValueItem fa fa-long-arrow-right" title="Changed" role="img"/>
                            <t t-if="value.new_value">
                                <div class="o_Message_trackingValueNewValue o_Message_trackingValueItem" t-esc="value.new_value"/>
                            </t>
                        </div>
                    </li>
                </t>
            </ul>
        </t>
    </t>

    <t
        t-name="llm_thread.Message"
        t-inherit="mail.Message"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[hasclass('o_Message_content')]" position="replace">
            <div
                class="o_Message_content position-relative text-break"
                t-att-class="{'opacity-75': props.isSquashed}"
                t-att-data-llm-kind="message.llmKind"
                t-ref="content"
            >
                <t t-if="message.llmRole === 'assistant'">
                    <t t-call="llm_thread.Message.AssistantContent" />
                </t>
                <t t-elif="message.llmRole === 'tool'">
                    <t t-call="llm_thread.Message.ToolResultContent" />
                </t>
                <t t-else="">
                    <t t-call="llm_thread.Message.DefaultContent" />
                </t>
                <div class="o_Message_linkPreviews" />
            </div>
        </xpath>
    </t>

</templates>
